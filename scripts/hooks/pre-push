#!/bin/sh
# Refuse to push firmware changes that were not PUBLISHED.
#
# The hosted hex (product repo, public/firmware/) is what install-nordic.sh and
# the IDE deliver to makers. It is a committed build artifact, so nothing keeps
# it aligned with these sources except this hook: a push touching src/ or
# zephyr/ while the published build id names an older commit means the next
# maker to run the installer gets a firmware missing what you just wrote.
#
# Activate once per clone:  git config core.hooksPath scripts/hooks
set -u

PRODUCT_DIR="${TEXTOCHIP_PRODUCT_DIR:-$HOME/projects/textochip}"
VERSION_FILE="$PRODUCT_DIR/public/firmware/textochip-nrf54lm20dk.version"

# No product repo on this machine (e.g. CI): nothing to check against.
[ -f "$VERSION_FILE" ] || exit 0

touches_firmware=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -qE '^(src|zephyr)/'; then
    touches_firmware=1
  fi
done

[ "$touches_firmware" = 1 ] || exit 0

published="$(cat "$VERSION_FILE")"
head="$(git rev-parse --short HEAD)"
if [ "$published" = "$head" ]; then
  exit 0
fi

echo ""
echo "!! This push changes firmware sources, but the PUBLISHED hex is at"
echo "!! '$published' and you are pushing '$head'. The next maker to run the"
echo "!! installer would get a firmware missing these changes."
echo "!!"
echo "!!     scripts/publish-hex.sh     # builds, publishes, then push again"
echo "!!"
echo "!! (bypass only if you know why: git push --no-verify)"
exit 1
