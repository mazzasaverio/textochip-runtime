/*
 * Board overlay for the Sakura Board VM.
 *
 * USB CDC-ACM console: redirect the Zephyr console to an app-provided CDC-ACM
 * UART on the USB-OTG controller (zephyr_udc0), instead of the ESP32-S3
 * USB-Serial-JTAG console. The JTAG console resets the chip whenever the host
 * toggles DTR/RTS (which Web Serial does on open); an app CDC-ACM does not, so
 * the IDE connects cleanly over the same native-USB port (like the Arduino
 * "USB CDC On Boot"). The HAL reads/writes DT_CHOSEN(zephyr,console), so it
 * picks this up automatically. See prj.conf for the matching CONFIG_* options.
 */
/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

