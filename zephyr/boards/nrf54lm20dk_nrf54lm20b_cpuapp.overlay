/*
 * Nordic nRF54LM20 DK — "B" chip overlay (Axon NPU voice build).
 *
 * IDENTICAL to the A overlay (LEDs/button/serial via the board devicetree;
 * buzzer PWM20, motors PWM21, the INMP441 mic on the TDM peripheral, psa_rng
 * disabled) — the B chip is the same board plus the Axon NPU, which this
 * overlay's ONE extra line (`&axon { status = "okay"; }`) enables for
 * Nordic's nRF Edge AI Library. See the A overlay for the pin rationale;
 * keep the two in sync.
 */

&pinctrl {
	tc_pwm20_default: tc_pwm20_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;	/* buzzer -> P1.13 (D5) */
		};
	};
	tc_pwm20_sleep: tc_pwm20_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;
			low-power-enable;
		};
	};
};

/ {
	aliases {
		tc-pwm-buzzer = &pwm20;
		tc-pwm-motor = &pwm21;
		/* Voice: the INMP441 on the TDM peripheral (nRF54L has no I2S block;
		 * TDM binds to the Zephyr I2S API). Same 16 kHz int16 audio the Nordic
		 * KWS model wants — no PDM required. */
		tc-mic = &tdm;
	};
};

/* Mic pins MUST be on PORT 1 (bench-proven: the TDM silently no-ops on P2 pads
 * on this SoC). SCK->P1.23, WS->P1.14, SD->P1.31. */
&pinctrl {
	tc_tdm_default: tc_tdm_default {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M, 1, 23)>,
				<NRF_PSEL(TDM_FSYNC_M, 1, 14)>,
				<NRF_PSEL(TDM_SDIN, 1, 31)>;
		};
	};
	tc_tdm_sleep: tc_tdm_sleep {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M, 1, 23)>,
				<NRF_PSEL(TDM_FSYNC_M, 1, 14)>,
				<NRF_PSEL(TDM_SDIN, 1, 31)>;
			low-power-enable;
		};
	};
};
&tdm {
	status = "okay";
	pinctrl-0 = <&tc_tdm_default>;
	pinctrl-1 = <&tc_tdm_sleep>;
	pinctrl-names = "default", "sleep";
};

/* No crypto (psa_rng CRACEN init hard-faults without a KMU seed). */
&psa_rng {
	status = "disabled";
};

&pwm20 {
	status = "okay";
	pinctrl-0 = <&tc_pwm20_default>;
	pinctrl-1 = <&tc_pwm20_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	tc_pwm21_default: tc_pwm21_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 7)>,	/* left  ENA -> P1.07 (D12) */
				<NRF_PSEL(PWM_OUT1, 1, 6)>;	/* right ENB -> P1.06 (D13) */
		};
	};
	tc_pwm21_sleep: tc_pwm21_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 7)>,
				<NRF_PSEL(PWM_OUT1, 1, 6)>;
			low-power-enable;
		};
	};
};
&pwm21 {
	status = "okay";
	pinctrl-0 = <&tc_pwm21_default>;
	pinctrl-1 = <&tc_pwm21_sleep>;
	pinctrl-names = "default", "sleep";
};

/* THE Axon NPU — the one thing the B build adds over the A build. Nordic's
 * nrf_edgeai runtime binds to this node to run the compiled KWS model. */
&axon {
	status = "okay";
};

/* ── Camera (SEE()/SEEX()/SEESIZE()): the Arducam Mega on SPI22 ───────────────
 * Pins were NOT copied from Nordic's person_detection overlay: that one puts
 * SCK/MISO/MOSI on P1.04-P1.06 with CS on P1.07, and P1.06/P1.07 are already
 * the two motor enables here (pwm21). D1-D4 are four free, ADJACENT header pins,
 * so the camera is one contiguous ribbon:
 *   CS -> D1 (P3.04)  SCK -> P1.10 (hole 10 on PORT1)  MISO -> D3 (P1.03)  MOSI -> D4 (P1.04)
 * The three bus signals stay on PORT 1 (one peripheral instance, one port — the
 * lesson the TDM mic taught); CS is an ordinary GPIO, so it may live on P3.
 * SPI22 is free: we hold serial instance 20 for the IDE link (uart20), and PWM
 * 20/21 are separate peripherals from the serial boxes. */
&pinctrl {
	tc_spi22_default: tc_spi22_default {
		group1 {
			/* SCK is on P1.08, NOT P1.02 (2026-08-02, bench).
			 * P1.01 and P1.02 are SHORTED TO GROUND on this DK: the
			 * chip drives them high and the board holds them at 0
			 * (runtime's PADS probe; every other P1 pad reads ok, and
			 * the short does not move when the maker's ground wire
			 * does). A grounded clock selects the camera and never
			 * clocks it, which is exactly how it failed. It also
			 * explains the earlier dead end with CS on P1.01. The SPI
			 * pins must stay on ONE port (the mic and motor-PWM rule),
			 * so the replacement is a P1 pad too. P1.08 works but is the
			 * DK's own BTN2 (pull-up, active-low): pressing that button
			 * would ground the clock, so the camera takes P1.10, which
			 * carries no on-board function. */
			psels = <NRF_PSEL(SPIM_SCK, 1, 10)>,	/* hole 10 on PORT1 */
				<NRF_PSEL(SPIM_MISO, 1, 3)>,	/* D3 */
				<NRF_PSEL(SPIM_MOSI, 1, 4)>;	/* D4 */
			bias-pull-down;
		};
	};
	tc_spi22_sleep: tc_spi22_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 10)>,
				<NRF_PSEL(SPIM_MISO, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 4)>;
			bias-pull-down;
			low-power-enable;
		};
	};
};

&spi22 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&tc_spi22_default>;
	pinctrl-1 = <&tc_spi22_sleep>;
	pinctrl-names = "default", "sleep";
	overrun-character = <0x00>;
	/* CS is back on P3.04 (2026-08-01). Moving it to P1.01 to put all four
	 * signals in a row was a GUESS about which pads the PORT1 header physically
	 * breaks out, and the probe still read 0xFF with the wire moved — nothing is
	 * claiming P1.01 in software, so the likeliest reading is that there is no
	 * such hole. Every P1 pad we can PROVE is on the header (docs/hardware.md's
	 * D-map: 02·03·04·05·06·07·13, plus the mic's 14/23/31) is already taken, so
	 * four-in-a-row was never available. P3.04 is D1 in that same map: proven to
	 * exist, and free. */
	cs-gpios = <&gpio3 4 GPIO_ACTIVE_LOW>;	/* P3.04 = D1, hole "04" on PORT3 */

	arducam: arducam-mega@0 {
		compatible = "arducam,mega";
		reg = <0>;
		spi-max-frequency = <8000000>;
		status = "okay";
	};
};

/* Rail measurement (2026-08-01, made permanent + FIXED 2026-08-02).
 *
 * The DK's VDD is CONFIGURABLE (Board Configurator), and Nordic's own Arducam
 * sample says in one line to set it to 3.3V for this camera. A rail at 1.8V
 * would leave the mic perfectly happy (it works from 1.62V) and the camera
 * powered-but-mute, which is exactly the symptom on the bench. So rather than
 * guess: the SAADC can sample VDD internally, with no wire and no instrument.
 *
 * It used to borrow /zephyr,user — and that was a real bug, not a tidy shortcut:
 * /zephyr,user is AREAD()'s node, so on this DK a program calling AREAD() read
 * the SUPPLY RAIL instead of a sensor. A maker's generated program used
 * `AREAD() > 2000` as a threshold and got a value that is always high, which is
 * unexplainable from the BASIC. The rail now has its OWN node.
 */
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
	};
};

/ {
	tc_rail: tc-rail {
		compatible = "voltage-divider";
		io-channels = <&adc 7>;
		output-ohms = <1>;
		full-ohms = <1>;
	};
};
