/*
 * Nordic nRF54LM20 DK overlay.
 *
 * Phase 1 (LEDs / button / serial / NVS) needs NO overrides: the DK's
 * devicetree already chooses &uart20 as the console, defines the on-board
 * LEDs/buttons that map_pin() targets, and provides storage_partition.
 *
 * Phase 2 slice 2 — MOTORS: on pwm21 (NOT pwm22 — that instance boot-faults
 * the app core; pwm21 is the board's expansion PWM and works). See below.
 *
 * Phase 2 slice 1 — BUZZER (TONE/SOUND/PLAY): route PWM20 channel 0 to
 * P1.13 (header pin D5, the board profile's buzzer) and label the instance
 * `pwm0` so hal_zephyr's tone() works unchanged (it drives
 * DT_NODELABEL(pwm0) channel 0).
 *
 * NOTE (nRF54 PWM design, see docs/nordic-nrf-connect-sdk.md): one PERIOD per
 * PWM instance — channels share the frequency. So SERVO (fixed 50 Hz) and the
 * MOVE motor enables (~1 kHz) must NOT join this instance: slice 2 gives them
 * pwm21/pwm22 with per-function specs in the HAL. Until then a program mixing
 * TONE and SERVO on this board would fight over the period.
 */

&pinctrl {
	tc_pwm20_default: tc_pwm20_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;	/* buzzer -> P1.13 (D5) */
		};
	};
	tc_pwm20_sleep: tc_pwm20_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 13)>;
			low-power-enable;
		};
	};

};

/ {
	aliases {
		/* Our OWN aliases — hal_zephyr resolves these (labelling a node `pwmN`
		 * trips Nordic's base-address validation, which ties pwmN labels to
		 * NRF_PWMN peripherals). */
		tc-pwm-buzzer = &pwm20;
		tc-pwm-motor = &pwm21;
		/* Voice: the INMP441 mic. The nRF54L has NO I2S block — its TDM
		 * peripheral is the superset and binds to Zephyr's I2S API, so the HAL
		 * (i2s_read) works unchanged pointed at &tdm. */
		tc-mic = &tdm;
	};
};

/* Phase 2 slice 3 — VOICE: the INMP441 I2S microphone on the TDM peripheral.
 * RX only (a mic): SCK (bit clock) + FSYNC (word select) driven out, SDIN read
 * in. PCLK clock (the driver default — no audio PLL) is fine for the 16 kHz KWS
 * model.
 *
 * PINS MUST BE ON PORT 1 — bench-proven 2026-07-14. The TDM cannot drive
 * P2 pads on the nRF54LM20A (PSEL accepts them, i2s_configure/trigger return 0,
 * the DMA fills blocks — but MICPINS showed the SCK pad flat while "capturing",
 * so the peripheral's pin mux silently no-ops outside its GPIO port domain).
 * Nordic's own i2s tests for this DK use P1.23/P1.14/P1.31 — we use the same.
 * Wiring — INMP441: VDD->VDDIO (3.3 V, NOT 5V0), GND->GND, L/R->GND (left
 * channel), SCK->P1.23, WS->P1.14, SD->P1.31. See docs/hardware.md. */
&pinctrl {
	tc_tdm_default: tc_tdm_default {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M, 1, 23)>,
				<NRF_PSEL(TDM_FSYNC_M, 1, 14)>,
				<NRF_PSEL(TDM_SDIN, 1, 31)>;
		};
	};
	tc_tdm_sleep: tc_tdm_sleep {
		group1 {
			psels = <NRF_PSEL(TDM_SCK_M, 1, 23)>,
				<NRF_PSEL(TDM_FSYNC_M, 1, 14)>,
				<NRF_PSEL(TDM_SDIN, 1, 31)>;
			low-power-enable;
		};
	};
};
&tdm {
	status = "okay";
	pinctrl-0 = <&tc_tdm_default>;
	pinctrl-1 = <&tc_tdm_sleep>;
	pinctrl-names = "default", "sleep";
};

/* No crypto. The DK devicetree enables a `zephyr,psa-crypto-rng` entropy node,
 * which drags the whole nrf_security/CRACEN PSA stack into the image — and its
 * boot-time init (CRACEN_IKG_SEED_LOAD) HARD-FAULTS if the KMU seed is absent,
 * e.g. after a `probe-rs erase` / ERASEALL (bench-verified: boot fault in
 * psa_crypto_init, board mute). We use no crypto, so drop the node: leaner
 * image, and the boot no longer depends on KMU provisioning state. If crypto
 * is ever needed (e.g. BLE), re-provision the IKG seed instead. */
&psa_rng {
	status = "disabled";
};

&pwm20 {
	status = "okay";
	pinctrl-0 = <&tc_pwm20_default>;
	pinctrl-1 = <&tc_pwm20_sleep>;
	pinctrl-names = "default", "sleep";
};


/* Phase 2 slice 2 — MOTORS (MOVE / L298N enables) on pwm21, the board's
 * designated nordic_expansion_pwm (app-core known-good; pwm22 boot-faults —
 * reserved/other domain). Two channels: left ENA -> P1.07 (D12), right ENB ->
 * P3.06 (D15) — both PWM-capable (P1/P3). The L298N IN1..IN4 dir pins are plain
 * GPIO via map_pin: left 10/11 -> P3.02/03 (D10/D11), right 13/14 -> P1.06/05
 * (D13/D14). Keep NORDIC_PINS + map_pin in sync. */
&pinctrl {
	tc_pwm21_default: tc_pwm21_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 7)>,	/* left  ENA -> P1.07 (D12) */
				<NRF_PSEL(PWM_OUT1, 1, 6)>;	/* right ENB -> P1.06 (D13) */
		};
	};
	tc_pwm21_sleep: tc_pwm21_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 7)>,
				<NRF_PSEL(PWM_OUT1, 1, 6)>;
			low-power-enable;
		};
	};
};
&pwm21 {
	status = "okay";
	pinctrl-0 = <&tc_pwm21_default>;
	pinctrl-1 = <&tc_pwm21_sleep>;
	pinctrl-names = "default", "sleep";
};

/* ── Camera (SEE()/SEEX()/SEESIZE()): the Arducam Mega on SPI22 ───────────────
 * Pins were NOT copied from Nordic's person_detection overlay: that one puts
 * SCK/MISO/MOSI on P1.04-P1.06 with CS on P1.07, and P1.06/P1.07 are already
 * the two motor enables here (pwm21). D1-D4 are four free, ADJACENT header pins,
 * so the camera is one contiguous ribbon:
 *   CS -> D1 (P3.04)  SCK -> D2 (P1.02)  MISO -> D3 (P1.03)  MOSI -> D4 (P1.04)
 * The three bus signals stay on PORT 1 (one peripheral instance, one port — the
 * lesson the TDM mic taught); CS is an ordinary GPIO, so it may live on P3.
 * SPI22 is free: we hold serial instance 20 for the IDE link (uart20), and PWM
 * 20/21 are separate peripherals from the serial boxes. */
&pinctrl {
	tc_spi22_default: tc_spi22_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 2)>,	/* D2 */
				<NRF_PSEL(SPIM_MISO, 1, 3)>,	/* D3 */
				<NRF_PSEL(SPIM_MOSI, 1, 4)>;	/* D4 */
			bias-pull-down;
		};
	};
	tc_spi22_sleep: tc_spi22_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 2)>,
				<NRF_PSEL(SPIM_MISO, 1, 3)>,
				<NRF_PSEL(SPIM_MOSI, 1, 4)>;
			bias-pull-down;
			low-power-enable;
		};
	};
};

&spi22 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&tc_spi22_default>;
	pinctrl-1 = <&tc_spi22_sleep>;
	pinctrl-names = "default", "sleep";
	overrun-character = <0x00>;
	/* CS is back on P3.04 (2026-08-01). Moving it to P1.01 to put all four
	 * signals in a row was a GUESS about which pads the PORT1 header physically
	 * breaks out, and the probe still read 0xFF with the wire moved — nothing is
	 * claiming P1.01 in software, so the likeliest reading is that there is no
	 * such hole. Every P1 pad we can PROVE is on the header (docs/hardware.md's
	 * D-map: 02·03·04·05·06·07·13, plus the mic's 14/23/31) is already taken, so
	 * four-in-a-row was never available. P3.04 is D1 in that same map: proven to
	 * exist, and free. */
	cs-gpios = <&gpio3 4 GPIO_ACTIVE_LOW>;	/* P3.04 = D1, hole "04" on PORT3 */

	arducam: arducam-mega@0 {
		compatible = "arducam,mega";
		reg = <0>;
		spi-max-frequency = <8000000>;
		status = "okay";
	};
};
