/*
 * Board overlay for the textochip runtime (Text to Chip).
 *
 * USB CDC-ACM console: redirect the Zephyr console to an app-provided CDC-ACM
 * UART on the USB-OTG controller (zephyr_udc0), instead of the ESP32-S3
 * USB-Serial-JTAG console. The JTAG console resets the chip whenever the host
 * toggles DTR/RTS (which Web Serial does on open); an app CDC-ACM does not, so
 * the IDE connects cleanly over the same native-USB port (like the Arduino
 * "USB CDC On Boot"). The HAL reads/writes DT_CHOSEN(zephyr,console), so it
 * picks this up automatically. See prj.conf for the matching CONFIG_* options.
 */
/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/*
 * Buzzer (PWM/tone) on GPIO5. The ESP32-S3 LEDC peripheral drives the passive
 * piezo with a square wave; hal_zephyr.cpp uses DT_NODELABEL(pwm0) channel 0, so
 * we give ledc0 the `pwm0` label + a channel routed to GPIO5 (the board profile's
 * buzzer pin). The mission must NOT gpio-configure GPIO5 (LEDC owns the pad).
 */
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

&pinctrl {
	ledc0_default: ledc0_default {
		group1 {
			pinmux = <LEDC_CH0_GPIO5>;
			output-enable;
		};
		/* Servo (SG90) signal on GPIO8 — LEDC channel 1. */
		group2 {
			pinmux = <LEDC_CH1_GPIO8>;
			output-enable;
		};
		/* Motor enables (L298N EN, MOVE opcode) — LEDC ch2 on GPIO12 (left wheel),
		 * ch3 on GPIO21 (right wheel). PROVISIONAL pins: finalize against the
		 * Freenove pinout when wiring the chassis. */
		group3 {
			pinmux = <LEDC_CH2_GPIO12>;
			output-enable;
		};
		group4 {
			pinmux = <LEDC_CH3_GPIO21>;
			output-enable;
		};
	};

	/* I2S digital microphone (INMP441) for the edge-AI voice tier. The ESP32-S3 is
	 * the I2S master: it drives the bit clock (BCK) + word select (WS) and reads the
	 * mic's serial data (SD). PROVISIONAL pins — BCK=GPIO15, WS=GPIO16, SD=GPIO17,
	 * with the mic's L/R tied to GND (left channel) — finalize against the Freenove
	 * pinout when wiring. */
	i2s0_default: i2s0_default {
		group1 {
			pinmux = <I2S0_I_BCK_GPIO15>, <I2S0_I_WS_GPIO16>;
			output-enable;
		};
		group2 {
			pinmux = <I2S0_I_SD_GPIO17>;
			input-enable;
		};
	};
};

/* The ESP32-S3 I2S peripheral streams through GDMA — the i2s0 node references
 * &dma, so the DMA controller must be enabled too (with CONFIG_DMA). */
&dma {
	status = "okay";
};

/* Enable the I2S controller for the mic (hal::aiCapture reads DT_NODELABEL(i2s0)).
 * Absent/disabled -> aiCapture returns 0 and VOICE() stays "none", so the build is
 * green with or without the mic wired. */
&i2s0 {
	pinctrl-0 = <&i2s0_default>;
	pinctrl-names = "default";
	status = "okay";
};

pwm0: &ledc0 {
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
	/* Servo channel: its OWN timer (1) so its fixed 50 Hz frame is independent
	 * of the buzzer's variable tone frequency on channel 0 / timer 0. */
	channel1@1 {
		reg = <0x1>;
		timer = <1>;
	};
	/* Motor PWM enables (MOVE / L298N) — both on timer 2 (~1 kHz, same freq for
	 * the two wheels; the duty sets each wheel's speed). */
	channel2@2 {
		reg = <0x2>;
		timer = <2>;
	};
	channel3@3 {
		reg = <0x3>;
		timer = <2>;
	};
};

/*
 * Analog input (AREAD / hal::analogRead). The HAL reads DT_PATH(zephyr_user)'s
 * io-channels; here that's ADC1 channel 8 = GPIO9 (the board profile's analog
 * pin). NOTE: the exact channel reg / gain may need tuning on the first
 * `west build` for the ESP32-S3 ADC — without a valid node the HAL falls back to
 * returning 0 (AREAD reads 0), so the build stays green either way.
 */
#include <zephyr/dt-bindings/adc/adc.h>

/ {
	zephyr,user {
		io-channels = <&adc0 8>;
	};
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
