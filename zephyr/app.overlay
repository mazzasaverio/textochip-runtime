/*
 * Board overlay for the textochip runtime (Text to Chip).
 *
 * USB CDC-ACM console: redirect the Zephyr console to an app-provided CDC-ACM
 * UART on the USB-OTG controller (zephyr_udc0), instead of the ESP32-S3
 * USB-Serial-JTAG console. The JTAG console resets the chip whenever the host
 * toggles DTR/RTS (which Web Serial does on open); an app CDC-ACM does not, so
 * the IDE connects cleanly over the same native-USB port (like the Arduino
 * "USB CDC On Boot"). The HAL reads/writes DT_CHOSEN(zephyr,console), so it
 * picks this up automatically. See prj.conf for the matching CONFIG_* options.
 */
/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/*
 * Buzzer (PWM/tone) on GPIO5. The ESP32-S3 LEDC peripheral drives the passive
 * piezo with a square wave; hal_zephyr.cpp uses DT_NODELABEL(pwm0) channel 0, so
 * we give ledc0 the `pwm0` label + a channel routed to GPIO5 (the board profile's
 * buzzer pin). The mission must NOT gpio-configure GPIO5 (LEDC owns the pad).
 */
#include <zephyr/dt-bindings/pinctrl/esp32s3-pinctrl.h>

&pinctrl {
	ledc0_default: ledc0_default {
		group1 {
			pinmux = <LEDC_CH0_GPIO5>;
			output-enable;
		};
		/* Servo (SG90) signal on GPIO8 — LEDC channel 1. */
		group2 {
			pinmux = <LEDC_CH1_GPIO8>;
			output-enable;
		};
	};
};

pwm0: &ledc0 {
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
	/* Servo channel: its OWN timer (1) so its fixed 50 Hz frame is independent
	 * of the buzzer's variable tone frequency on channel 0 / timer 0. */
	channel1@1 {
		reg = <0x1>;
		timer = <1>;
	};
};

/*
 * Analog input (AREAD / hal::analogRead). The HAL reads DT_PATH(zephyr_user)'s
 * io-channels; here that's ADC1 channel 8 = GPIO9 (the board profile's analog
 * pin). NOTE: the exact channel reg / gain may need tuning on the first
 * `west build` for the ESP32-S3 ADC — without a valid node the HAL falls back to
 * returning 0 (AREAD reads 0), so the build stays green either way.
 */
#include <zephyr/dt-bindings/adc/adc.h>

/ {
	zephyr,user {
		io-channels = <&adc0 8>;
	};
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
